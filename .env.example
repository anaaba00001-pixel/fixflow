VITE_APP_NAME=FixFlow
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets belong in Supabase Secrets, never in a VITE_ variable:
# SUPABASE_SERVICE_ROLE_KEY
# RESEND_API_KEY
# EMAIL_FROM
# APP_URL
# PUBLIC_SITE_URL
# QR_TOKEN_ENCRYPTION_KEY (long random secret used only by the asset-qr Edge Function)
# CRON_SECRET
